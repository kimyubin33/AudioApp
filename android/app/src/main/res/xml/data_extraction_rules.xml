<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 이상용 백업/기기 이전 규칙.
     로그인 토큰(암호화본)은 Keystore 키와 짝이라 다른 기기에서는 쓸 수 없으므로 모두 뺀다. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="secure_token.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="secure_token.xml" />
    </device-transfer>
</data-extraction-rules>
