<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 이상용 백업/기기 이전 규칙.
     - secure_token.xml: 로그인 토큰(암호화본)은 Keystore 키와 짝이라 다른 기기에서는 쓸 수 없으므로 모두 뺀다.
     - library.xml: 시청 기록·저장 목록은 이 기기 안에서만 쓰는 개인 기록이라 백업하지 않는다. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="secure_token.xml" />
        <exclude domain="sharedpref" path="library.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="secure_token.xml" />
        <exclude domain="sharedpref" path="library.xml" />
    </device-transfer>
</data-extraction-rules>
