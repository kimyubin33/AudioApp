<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- debug 빌드 전용. Android 17(targetSdk 37)부터는 사설망 주소로의 연결이 기본으로 막혀서,
         에뮬레이터에서 PC의 목업 서버(10.0.2.2)에 접속하려면 이 권한이 필요하다.
         실제 서버는 공개 주소라서 release 앱에는 이 권한을 넣지 않는다. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <application>
        <!-- Design simulator only: never included in release or permitted as a driving activity. -->
        <activity android:name=".vehicle.InkSimulatorActivity"
            android:exported="true" android:label="Ink Studio">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
